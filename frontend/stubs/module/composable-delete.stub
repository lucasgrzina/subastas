import { useMutation, useQueryClient } from '@tanstack/vue-query'
import { delete{{ studlyName }}Api } from '../api/{{ kebabPlural }}.api'
import { useNotification } from '@/core/composables/useNotification'
import { useConfirm } from '@/core/composables/useConfirm'
import type { {{ studlyName }}Item } from '../types/{{ kebabName }}.types'

export function useDelete{{ studlyName }}() {
  const queryClient = useQueryClient()
  const { success, error } = useNotification()
  const confirm = useConfirm()

  const mutation = useMutation({
    mutationFn: (guid: string) => delete{{ studlyName }}Api(guid),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['{{ camelPlural }}'] })
      success('{{ entityLabel }} eliminado correctamente')
    },
    onError: () => {
      error('Error al eliminar {{ entityLabelLower }}')
    },
  })

  async function delete{{ studlyName }}(item: {{ studlyName }}Item) {
    await confirm.confirm({
      title: 'Eliminar {{ entityLabelLower }}',
      message: `¿Estás seguro de que querés eliminar "${item.{{ titleField }}}"? Esta acción no se puede deshacer.`,
      confirmLabel: 'Eliminar',
      danger: true,
      onConfirm: () => mutation.mutateAsync(item.guid),
    })
  }

  return { ...mutation, delete{{ studlyName }} }
}
